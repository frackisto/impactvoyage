# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Entourez les clés de guillemets : sans eux, tout ce qui suit un « # » est ignoré.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="change-me-in-production"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production uniquement : origines HTTPS autorisées pour l'admin (ex. https://admin.mondomaine.com)
CSRF_TRUSTED_ORIGINS=

# --- Base de données PostgreSQL ---
DATABASE_NAME=voyage_db
DATABASE_USER=voyage_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
# Optionnel : par défaut, base 2 du même serveur que REDIS_URL
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:3000
# URL publique du backend (liens vers l'admin dans les emails à l'agence)
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret partagé avec le serveur Next.js : il transmet l'adresse réelle des visiteurs
# pour la limitation de débit (apps/core/throttling.py). Avec Docker, il est fourni par
# le fichier .env racine (même valeur pour le backend et le frontend).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
FRONTEND_SHARED_SECRET=
# Proxys devant Django : 0 (développement), 1 derrière Nginx en production.
NUM_PROXIES=0

# --- JWT ---
# Clé de signature des jetons, distincte de SECRET_KEY (par défaut : SECRET_KEY)
JWT_SIGNING_KEY="change-me-too"
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email (à configurer en Phase 20 « Notifications ») ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@agence-voyage.com
AGENCY_NOTIFICATION_EMAIL=contact@agence-voyage.com
