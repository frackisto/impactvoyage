# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Entourez les clés de guillemets : sans eux, tout ce qui suit un « # » est ignoré.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY="change-me-in-production"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production uniquement : origines HTTPS autorisées pour l'admin (ex. https://admin.mondomaine.com)
CSRF_TRUSTED_ORIGINS=

# --- Sécurité (Phase 23) ---
# Adresse du backoffice, sans barre oblique. Obligatoirement non standard en production
# (ex. gestion-7k2p) : /admin/ répond alors 404. Défaut : admin.
ADMIN_URL_PATH=admin
# Double authentification de l'équipe (backoffice et connexion à l'API) : facultative en
# développement (False par défaut), toujours active en production.
STAFF_OTP_REQUIRED=False
# Documentation de l'API (/api/v1/docs/) : publique en développement, réservée à
# l'équipe connectée au backoffice en production.
API_DOCS_PUBLIC=True
# Clé secrète Cloudflare Turnstile (anti-robot des formulaires publics). Vide : vérification
# désactivée. Clé de test toujours valide : 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# --- Base de données PostgreSQL ---
DATABASE_NAME=voyage_db
DATABASE_USER=voyage_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
# Optionnel : par défaut, base 2 du même serveur que REDIS_URL
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:3000
# URL publique du backend (liens vers l'admin dans les emails à l'agence)
BACKEND_URL=http://localhost:8000
# Le navigateur n'appelle jamais Django directement : vide en production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret partagé avec le serveur Next.js : il transmet l'adresse réelle des visiteurs
# pour la limitation de débit (apps/core/throttling.py). Avec Docker, il est fourni par
# le fichier .env racine (même valeur pour le backend et le frontend).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
FRONTEND_SHARED_SECRET=
# Route de régénération des pages du site, vue depuis le backend : le site affiche un
# contenu modifié dans l'admin sans attendre l'expiration de son cache (5 min).
# Dans Docker, fournie par docker-compose.yml. Vide : désactivée.
FRONTEND_REVALIDATE_URL=
# Proxys devant Django : 0 (développement), 1 derrière Nginx en production.
NUM_PROXIES=0

# --- JWT ---
# Clé de signature des jetons, distincte de SECRET_KEY (par défaut : SECRET_KEY)
JWT_SIGNING_KEY="change-me-too"
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email ---
# Développement : laisser EMAIL_HOST vide, les emails sont capturés par Mailpit
# (http://localhost:8025). Production : serveur SMTP du prestataire d'envoi.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@agence-voyage.com
AGENCY_NOTIFICATION_EMAIL=contact@agence-voyage.com

# --- Mesure d'audience (Umami, lue par le tableau de bord de l'admin) ---
# Laisser vide tant qu'Umami n'est pas déployé (Phase 24).
UMAMI_API_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_TOKEN=

# --- Notifications de l'agence ---
# Canaux actifs (séparés par des virgules). WhatsApp et SMS sont prêts :
#   apps.notifications.channels.WhatsAppChannel, apps.notifications.channels.SmsChannel
# (numéros pris dans le profil de chaque membre de l'équipe).
# STAFF_NOTIFICATION_CHANNELS=apps.notifications.channels.DashboardChannel,apps.notifications.channels.AgencyEmailChannel
# Prestataire WhatsApp / SMS (par défaut : simple journalisation).
# SHORT_MESSAGE_BACKEND=apps.notifications.channels.ConsoleBackend
# Adresse des images des emails (emblème), par défaut FRONTEND_URL.
# EMAIL_ASSETS_URL=https://www.impactvoyage.ci
