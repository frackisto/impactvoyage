# Configuration de production (Phase 24) — copier en .env.prod (jamais commité) :
#   cp .env.prod.example .env.prod
# Lue par docker-compose.prod.yml (--env-file .env.prod) et transmise à Django.
# Entourez de guillemets les valeurs qui contiennent « # », « $ » ou des espaces.
# Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(50))"
#              ou : openssl rand -base64 48 | tr -d '/+=' | cut -c1-50

# --- Domaines (enregistrements DNS A/AAAA vers le serveur) ---
# Site public (Next.js) : URL canonique, sitemap, liens des emails.
SITE_DOMAIN=www.impactvoyage.ci
# Autres noms redirigés vers SITE_DOMAIN (séparés par des espaces), ex. le domaine nu.
SITE_ALIASES=impactvoyage.ci
# Django : backoffice (à l'adresse ADMIN_URL_PATH), API, documentation.
API_DOMAIN=gestion.impactvoyage.ci
# Interface d'Umami (statistiques de fréquentation).
STATS_DOMAIN=stats.impactvoyage.ci

# --- Certificat TLS Let's Encrypt (un seul certificat pour tous les domaines) ---
# Email des alertes d'expiration. Vide : certificat autosigné (essai local uniquement).
LETSENCRYPT_EMAIL=contact@impactvoyage.ci
# 1 : certificat de test de Let's Encrypt (premier essai, sans risque de quota).
LETSENCRYPT_STAGING=0

# --- Django ---
# Clés de 50 caractères au moins (la configuration refuse de démarrer sinon).
SECRET_KEY="a-remplacer-par-une-cle-aleatoire-de-50-caracteres-minimum-xxxxxxxxx"
JWT_SIGNING_KEY="a-remplacer-par-une-autre-cle-aleatoire-de-32-caracteres-minimum"
# Adresse du backoffice, non standard et secrète : https://API_DOMAIN/<ADMIN_URL_PATH>/
ADMIN_URL_PATH=gestion-a-remplacer
# Gunicorn : nombre de processus (2 × cœurs + 1).
WEB_CONCURRENCY=3

# --- Base de données (PostgreSQL) ---
DATABASE_NAME=voyage_db
DATABASE_USER=voyage_user
DATABASE_PASSWORD="a-remplacer-mot-de-passe-base"

# --- Secret partagé Django / serveur Next.js (32 caractères au moins) ---
FRONTEND_SHARED_SECRET="a-remplacer-secret-partage-de-32-caracteres-minimum"

# --- Anti-robot Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) ---
# Clé du site, figée au build du frontend (reconstruire après un changement).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (prestataire SMTP : Brevo, Mailjet, Amazon SES...) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@impactvoyage.ci
AGENCY_NOTIFICATION_EMAIL=contact@impactvoyage.ci

# --- Mesure d'audience (Umami) ---
# Mot de passe de la base « umami » et secret de l'application.
UMAMI_DB_PASSWORD="a-remplacer-mot-de-passe-umami"
UMAMI_APP_SECRET="a-remplacer-secret-umami"
# Après le premier démarrage (DEPLOIEMENT.md, « Umami ») : identifiant du site créé dans
# Umami (lu par le site et par le tableau de bord) et clé d'API (umami_…) du tableau de bord.
UMAMI_WEBSITE_ID=
UMAMI_API_TOKEN=

# --- Sauvegardes ---
# Heure UTC (celle d'Abidjan), dossier sur le serveur (à recopier ailleurs), durées en jours.
BACKUP_TIME=02:30
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
MEDIA_BACKUP_RETENTION_DAYS=7

# --- Recette uniquement ---
# true : site jamais indexé (robots.txt « Disallow: / », balise noindex).
SEO_NOINDEX=false
# True : autorise « manage.py seed_demo » (données fictives). Jamais sur le site public.
DEMO_DATA_ALLOWED=False
