# --- Serveur Next.js uniquement (jamais exposé au navigateur) ---
# URL de l'API Django vue depuis le serveur Next.js.
# En local : http://localhost:8000/api/v1 ; dans Docker : http://backend:8000/api/v1
API_URL=http://localhost:8000/api/v1

# --- Public (préfixe NEXT_PUBLIC_, inclus dans le code navigateur : aucun secret) ---
# URL publique du site (balises canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hôte public des médias Django (images du catalogue).
NEXT_PUBLIC_MEDIA_URL=http://localhost:8000
