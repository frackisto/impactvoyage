# --- Serveur Next.js uniquement (jamais exposé au navigateur) ---
# URL de l'API Django vue depuis le serveur Next.js.
# En local : http://localhost:8000/api/v1 ; dans Docker : http://backend:8000/api/v1
API_URL=http://localhost:8000/api/v1
# Secret partagé avec Django (même valeur que FRONTEND_SHARED_SECRET du .env racine) :
# le serveur Next.js transmet l'adresse réelle des visiteurs pour la limitation de débit.
FRONTEND_SHARED_SECRET=
# Recette : true interdit l'indexation (robots.txt « Disallow: / » et balise noindex).
# À définir au build et au démarrage du serveur ; jamais en production.
SEO_NOINDEX=false

# --- Public (préfixe NEXT_PUBLIC_, inclus dans le code navigateur : aucun secret) ---
# URL publique du site (balises canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clé du site Cloudflare Turnstile (anti-robot des formulaires ; la clé secrète va dans
# le backend : TURNSTILE_SECRET_KEY). Vide : pas de widget, vérification désactivée.
# Clé de test toujours valide : 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
