# Utilisé uniquement par docker-compose.yml pour initialiser le service PostgreSQL.
# Doit correspondre aux valeurs définies dans backend/.env
DATABASE_NAME=voyage_db
DATABASE_USER=voyage_user
DATABASE_PASSWORD=change-me

# Secret partagé entre le backend et le serveur Next.js (limitation de débit par
# visiteur, voir backend/apps/core/throttling.py), transmis aux deux services.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
FRONTEND_SHARED_SECRET=change-me-frontend-secret

# Clé du site Cloudflare Turnstile (anti-robot des formulaires), figée au build du
# frontend ; la clé secrète correspondante va dans backend/.env (TURNSTILE_SECRET_KEY).
# Vide : pas de widget. Clé de test toujours valide : 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
